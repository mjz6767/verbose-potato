{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ash & Brimstone advisory AI visual QA review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "advisory",
    "releaseVersion",
    "captureSetSha256",
    "reviewer",
    "transmission",
    "captureIds",
    "overallAssessment",
    "findings",
    "uncertainties",
    "limitations",
    "humanReview"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "advisory": {
      "const": true
    },
    "releaseVersion": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "captureSetSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "reviewedAtUtc"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reviewedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "transmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "externalTransmissionExplicitlyApproved",
        "store",
        "sentFiles"
      ],
      "properties": {
        "mode": {
          "enum": [
            "local-workspace",
            "external-api"
          ]
        },
        "externalTransmissionExplicitlyApproved": {
          "type": "boolean"
        },
        "store": {
          "const": false
        },
        "sentFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*\\.png|visual-qa-packet\\.json)$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "external-api"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "externalTransmissionExplicitlyApproved": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "local-workspace"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "externalTransmissionExplicitlyApproved": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "captureIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*@[1-9][0-9]*x[1-9][0-9]*$"
      }
    },
    "overallAssessment": {
      "enum": [
        "no-blocker-observed",
        "findings-require-disposition",
        "unable-to-assess"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "captureIds",
          "category",
          "severity",
          "confidence",
          "evidence",
          "region",
          "recommendation",
          "uncertainty",
          "humanDisposition",
          "humanNotes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[0-9]{3}$"
          },
          "captureIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*@[1-9][0-9]*x[1-9][0-9]*$"
            }
          },
          "category": {
            "enum": [
              "overlap",
              "clipping",
              "legibility",
              "contrast",
              "hierarchy",
              "state-clarity",
              "cross-resolution-inconsistency",
              "baseline-regression",
              "debug-artifact",
              "other"
            ]
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor",
              "note"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "region": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  }
                }
              }
            ]
          },
          "recommendation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "uncertainty": {
            "type": "string",
            "maxLength": 1000
          },
          "humanDisposition": {
            "enum": [
              "pending",
              "accepted",
              "rejected",
              "deferred"
            ]
          },
          "humanNotes": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "reviewedAtUtc",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "completed"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "reviewedAtUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewedAtUtc": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    }
  }
}
